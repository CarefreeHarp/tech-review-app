// ======================================================
// USUARIOS Y RED SOCIAL
// ======================================================

Table users {
  id int [pk, increment]

  firebase_uid text [not null, unique]
  email text [not null, unique]
  username text [not null, unique]
  biography text
  profile_image_url text

  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table follows {
  follower_id int [not null]
  followed_id int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (follower_id, followed_id) [pk]
  }

  Note: 'Un usuario no puede seguirse a sí mismo.'
}

// ======================================================
// CATÁLOGO DE PRODUCTOS
// ======================================================

Table categories {
  id int [pk, increment]
  parent_category_id int

  name text [not null]
  description text

  indexes {
    (parent_category_id, name) [unique]
  }

  Note: 'parent_category_id permite manejar categorías y subcategorías.'
}

Table brands {
  id int [pk, increment]

  name text [not null, unique]
}

Table articles {
  id int [pk, increment]

  category_id int [not null]
  brand_id int [not null]

  name text [not null]
  model text
  description text
  image_url text
  release_date date
  specifications json

  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// ======================================================
// TIENDAS
// ======================================================

Table stores {
  id int [pk, increment]

  name text [not null, unique]
  website_url text
}

Table article_stores {
  article_id int [not null]
  store_id int [not null]

  product_url text [not null]

  indexes {
    (article_id, store_id) [pk]
  }

  Note: 'Indica en qué tiendas se puede comprar cada artículo.'
}

// ======================================================
// RESEÑAS Y COMENTARIOS
// ======================================================

Table reviews {
  id int [pk, increment]

  user_id int [not null]
  article_id int [not null]

  rating int [not null]
  title text
  body text [not null]

  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, article_id) [unique]
  }

  Note: 'Solo puede existir una reseña por usuario y artículo. La calificación debe estar entre 0 y 5.'
}

Table comments {
  id int [pk, increment]

  review_id int [not null]
  user_id int [not null]
  parent_comment_id int

  body text [not null]
  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'parent_comment_id permite responder a otro comentario.'
}

// ======================================================
// LIKES Y GUARDADOS
// ======================================================

Table review_likes {
  id int [pk, increment]

  user_id int
  review_id int [not null]

  indexes {
    (user_id, review_id) [unique]
  }

  Note: 'Si se elimina el usuario, el like permanece con user_id en NULL.'
}

Table comment_likes {
  id int [pk, increment]

  user_id int
  comment_id int [not null]

  indexes {
    (user_id, comment_id) [unique]
  }

  Note: 'Si se elimina el usuario, el like permanece con user_id en NULL.'
}

Table review_bookmarks {
  user_id int [not null]
  review_id int [not null]

  indexes {
    (user_id, review_id) [pk]
  }
}

// ======================================================
// NOTIFICACIONES
// ======================================================

Table notifications {
  id int [pk, increment]

  user_id int [not null]
  actor_user_id int

  type text [not null]

  review_id int
  comment_id int

  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Note: 'user_id es el usuario que recibe la notificación. actor_user_id es quien la genera. type puede ser review_like, comment_like o follow. review_id y comment_id identifican el contenido relacionado cuando corresponda.'
}

// ======================================================
// RELACIONES
// ======================================================

// Seguidores y seguidos
Ref: follows.follower_id > users.id [delete: cascade]
Ref: follows.followed_id > users.id [delete: cascade]

// Categorías y subcategorías
Ref: categories.parent_category_id > categories.id [delete: set null]

// Artículos
Ref: articles.category_id > categories.id [delete: restrict]
Ref: articles.brand_id > brands.id [delete: restrict]

// Tiendas y artículos
Ref: article_stores.article_id > articles.id [delete: cascade]
Ref: article_stores.store_id > stores.id [delete: cascade]

// Reseñas
Ref: reviews.user_id > users.id [delete: cascade]
Ref: reviews.article_id > articles.id [delete: restrict]

// Comentarios y respuestas
Ref: comments.review_id > reviews.id [delete: cascade]
Ref: comments.user_id > users.id [delete: cascade]
Ref: comments.parent_comment_id > comments.id [delete: set null]

// Likes de reseñas
Ref: review_likes.user_id > users.id [delete: set null]
Ref: review_likes.review_id > reviews.id [delete: cascade]

// Likes de comentarios
Ref: comment_likes.user_id > users.id [delete: set null]
Ref: comment_likes.comment_id > comments.id [delete: cascade]

// Reseñas guardadas
Ref: review_bookmarks.user_id > users.id [delete: cascade]
Ref: review_bookmarks.review_id > reviews.id [delete: cascade]

// Notificaciones
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.actor_user_id > users.id [delete: set null]
Ref: notifications.review_id > reviews.id [delete: cascade]
Ref: notifications.comment_id > comments.id [delete: cascade]